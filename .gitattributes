# Normalize every text file to LF in the repository (checkout stays LF too).
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.exe binary
*.dll binary
*.pdf binary
*.woff binary
*.woff2 binary
*.npy binary

# The lockfile is generated, so keep it out of language statistics — but leave it
# diffable: dependency changes must stay reviewable in pull requests.
studio/package-lock.json linguist-generated=true

# Documentation-only trees are not counted as source code.
verification/** linguist-documentation=true
*.md linguist-documentation=true
