# Normalize every text file to LF in the repository (checkout stays LF too).
* text=auto eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.exe binary
*.dll binary
*.pdf binary
*.woff binary
*.woff2 binary
*.npy binary

# Generated bundles: keep them out of diffs and language statistics.
studio/scripts/*.mjs linguist-generated=true
studio/package-lock.json linguist-generated=true -diff

# Documentation-only trees are not counted as source code.
verification/** linguist-documentation=true
*.md linguist-documentation=true
