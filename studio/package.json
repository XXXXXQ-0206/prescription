{
  "name": "prescription-master",
  "productName": "Prescription Master",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Prescription Master —— 选择医院/诊断/药品等生成处方单据，Typst 排版并导出 PDF/PNG",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "shot": "node scripts/start.mjs --shot",
    "electron": "electron .",
    "pack": "node scripts/pack.mjs",
    "bundle": "node scripts/bundle.mjs",
    "fetch:typst": "node scripts/fetch-typst.mjs",
    "render": "npm run bundle && node scripts/render-all.mjs",
    "diag:long": "npm run bundle && node scripts/long-diag.mjs",
    "stress": "npm run bundle && node scripts/stress-templates.mjs",
    "test": "npm run bundle && node scripts/test-variants.mjs && node scripts/test-extremes.mjs && node scripts/test-gen.mjs && node scripts/check-presets.mjs && node scripts/check-tcm.mjs && node scripts/check-odrisk.mjs",
    "test:variants": "npm run bundle && node scripts/test-variants.mjs",
    "test:extremes": "npm run bundle && node scripts/test-extremes.mjs",
    "test:gen": "npm run bundle && node scripts/test-gen.mjs",
    "test:qr": "npm run bundle && node scripts/test-qr.mjs",
    "check:presets": "npm run bundle && node scripts/check-presets.mjs",
    "check:tcm": "npm run bundle && node scripts/check-tcm.mjs",
    "check:odrisk": "npm run bundle && node scripts/check-odrisk.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "rolldown": "^1.2.13",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.prescriptionmaster.desktop",
    "productName": "Prescription Master",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/typst.exe",
        "to": "typst.exe"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prescription Master",
      "artifactName": "Prescription-Master-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Prescription-Master-Portable-${version}.${ext}"
    }
  }
}
